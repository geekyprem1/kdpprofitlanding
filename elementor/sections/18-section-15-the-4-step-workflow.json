              "settings": {
                "html": "<section class=\"sec-editorial bg-img-stack text-center\">\n    <div class=\"overlay-layer overlay-light-gold\"></div>\n    <div class=\"container\">\n      <div class=\"eyebrow-badge\">SIMPLE WORKFLOW</div>\n      <h2 class=\"sec-title\">The 4-Step KDP Profit Machine Workflow</h2>\n\n      <div class=\"grid-4 text-left\" style=\"margin-top: 40px;\">\n        <div class=\"card-panel\" style=\"border-top: 5px solid var(--amber-bright);\">\n          <div class=\"mono-spec\" style=\"font-size: 1.4rem; font-weight: 900; color: var(--amber-dark);\">1. RESEARCH</div>\n          <p style=\"margin-top: 10px;\">Type a topic → 20 niches scored 0–100 with recommended book types.</p>\n        </div>\n\n        <div class=\"card-panel\" style=\"border-top: 5px solid var(--amber-bright);\">\n          <div class=\"mono-spec\" style=\"font-size: 1.4rem; font-weight: 900; color: var(--amber-dark);\">2. CREATE</div>\n          <p style=\"margin-top: 10px;\">Pick a format, click generate → AI builds the full interior + cover.</p>\n        </div>\n\n        <div class=\"card-panel\" style=\"border-top: 5px solid var(--amber-bright);\">\n          <div class=\"mono-spec\" style=\"font-size: 1.4rem; font-weight: 900; color: var(--amber-dark);\">3. PACKAGE</div>\n          <p style=\"margin-top: 10px;\">One click → your Launch Kit (keywords, categories, description, checklist).</p>\n        </div>\n\n        <div class=\"card-panel\" style=\"border-top: 5px solid var(--amber-bright);\">\n          <div class=\"mono-spec\" style=\"font-size: 1.4rem; font-weight: 900; color: var(--amber-dark);\">4. PUBLISH</div>\n          <p style=\"margin-top: 10px;\">Download compliant files → upload to Amazon KDP with zero errors.</p>\n        </div>\n      </div>\n      <div style=\"margin-top: 30px; font-size: 1.2rem; font-weight: 800; color: var(--emerald-pass); position: relative; z-index: 2;\">\n        No writing. No designing. No rejections.\n      </div>\n    </div>\n 