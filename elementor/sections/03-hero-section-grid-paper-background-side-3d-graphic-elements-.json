              "settings": {
                "html": "<section class=\"sec-editorial bg-grid-paper text-center\" id=\"hero\">\n    <div class=\"overlay-layer overlay-light-gold\"></div>\n\n    <!-- TOP-LEFT AMBIENT GLOW AURA (MATCHING REFERENCE SCREENSHOT) -->\n    <div class=\"hero-glow-aura-left\"></div>\n\n    <!-- FLOATING 3D GRAPHIC ELEMENTS ON BOTH SIDES (MATCHING REFERENCE SCREENSHOT) -->\n    <img src=\"/wp-content/uploads/kdp-mafia/assets/analytics_3d.png\" alt=\"3D Analytics Search Graphic\" class=\"hero-side-graphic-right\">\n    <div class=\"hero-side-graphic-left\" style=\"background: #ffffff; border: 2px solid #a5f3fc; padding: 14px; border-radius: 20px; box-shadow: 0 15px 35px rgba(2,132,199,0.2);\">\n      <div style=\"font-size: 2.2rem; margin-bottom: 4px;\">📖💡</div>\n      <div style=\"font-size: 0.78rem; font-weight: 900; color: var(--blue-cobalt);\" class=\"mono-spec\">KDP SPEC PASSED</div>\n    </div>\n\n    <div class=\"container\">\n      \n      <!-- SECTION 1: EYEBROW / PRE-HEADLINE (ROUNDED PILL BADGE MATCHING SCREENSHOT) -->\n      <div class=\"eyebrow-badge\">\n        Turn Any Single Keyword Into Real Amazon-Compliant Books Across 20+ Formats In Minutes!\n      </div>\n      \n      <!-- SECTION 2: MAIN HEADLINE WITH ORANGE HIGHLIGHT BOX (MATCHING REFINED COPYWRITING USP ANGLE) -->\n      <h1 class=\"sec-title\" style=\"font-size: 3.2rem; max-width: 1080px; margin: 0 auto 20px; line-height: 1.25;\">\n        World's First <span class=\"highlight-orange-box\">Autonomous KDP Publishing Engine</span> <br>\n        Turns Single Keywords Into <span style=\"color: var(--amber-dark);\">Real Amazon-Compliant Books Across 20+ Formats</span> <span style=\"color: #c026d3;\">Without Ever Worrying About Trim Rejections Or AI Slop Flags Again!</span>\n      </h1>\n\n      <!-- SECTION 3: DARK FORMAT PILL BAR (MATCHING REFERENCE SCREENSHOT) -->\n      <div class=\"dark-pill-bar\">\n        Create Unlimited <span style=\"color: #f97316;\">Books</span> &nbsp;•&nbsp; <span style=\"color: #f59e0b;\">Journals</span> &nbsp;•&nbsp; <span style=\"color: #ea580c;\">Planners</span>\n      </div>\n\n      <!-- SECTION 4: BRUSH STROKE BANNER (MATCHING REFERENCE SCREENSHOT) -->\n      <div style=\"margin-bottom: 35px;\">\n        <div class=\"brush-stroke-banner\">\n          & More From One Powerful Autonomous AI Dashboard\n        </div>\n      </div>\n\n      <!-- SECTION 5: SUB-HEADLINE & DECK -->\n      <p class=\"sec-desc\" style=\"font-size: 1.3rem; max-width: 950px; margin-bottom: 30px;\">\n        Research a profitable niche… generate verified puzzle interiors, coloring pages, journals, planners, workbooks AND voice-locked ebooks… design a scroll-stopping 3D cover… and get a complete KDP \"Launch Kit\" — all from ONE dashboard. Every file built to Amazon's exact specs, so it passes on the first upload.\n      </p>\n\n      <!-- SECTION 6: HERO VIDEO / VSL BLOCK -->\n      <div style=\"max-width: 880px; margin: 0 auto 35px; padding: 8px; background: linear-gradient(135deg, #fef08a 0%, #f59e0b 100%); border-radius: var(--radius-lg); box-shadow: var(--shadow-amber); position: relative; z-index: 2;\">\n        <div style=\"position: relative; width: 100%; padding-top: 56.25%; background: #0b0f19; border-radius: 20px; overflow: hidden;\" id=\"vslInner\">\n          <img src=\"/wp-content/uploads/kdp-mafia/assets/bundle.png\" alt=\"4-Minute Demo Video\" style=\"position: absolute; top:0; left:0; width:100%; height:100%; object-fit: cover; opacity: 0.85;\">\n          <div id=\"playBtn\" style=\"position: absolute; top:50%; left:50%; transform: translate(-50%, -50%); width: 95px; height: 95px; background: linear-gradient(180deg, #fbbf24 0%, #d97706 100%); border-radius: 50%; display: flex; justify-content: center; align-items: center; cursor: pointer; box-shadow: 0 0 40px rgba(245, 158, 11, 0.8); border: 4px solid #ffffff;\">\n            <div style=\"width:0; height:0; border-top: 16px solid transparent; border-bottom: 16px solid transparent; border-left: 28px solid #ffffff; margin-left: 6px;\"></div>\n          </div>\n          <div style=\"position: absolute; bottom: 18px; width: 100%; text-align: center; color: #ffffff; font-weight: 800; font-size: 1.15rem; text-shadow: 0 2px 10px rgba(0,0,0,0.9);\">\n            ▶ WATCH THE 4-MINUTE DEMO (Watch a finished book pass Amazon's KDP Print Previewer with zero errors)\n          </div>\n        </div>\n      </div>\n\n      <!-- SECTION 7: TOP CTA (ABOVE THE FOLD) -->\n      <div style=\"display: flex; flex-direction: column; align-items: center; gap: 14px;\">\n        <a href=\"#checkout\" class=\"btn-editorial-gold\">\n          👉 GET INSTANT ACCESS TO KDP Profit Machine — JUST $17 TODAY\n          <span class=\"btn-caption\">YES! CLAIM MY DIME-SALE DISCOUNT • Commercial License Included</span>\n        </a>\n        <div style=\"display: flex; gap: 18px; font-size: 0.95rem; color: var(--ink-muted); font-weight: 700;\">\n          <span>✅ Commercial License</span>\n          <span>•</span>\n          <span>✅ 30-Day Money-Back Guarantee</span>\n          <span>•</span>\n          <span>✅ Instant Access</span>\n        </div>\n        <div class=\"mono-spec\" style=\"color: var(--crimson-fail); font-weight: 800; margin-top: 4px;\">\n          ⚡ Dime-sale active: the price rises with every single copy sold. This is the lowest it will ever be.\n        </div>\n      </div>\n    </div>\n  </section>",
