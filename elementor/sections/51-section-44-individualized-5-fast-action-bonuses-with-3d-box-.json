              "isInner": false,
              "settings": {
                "html": "<section class=\"sec-editorial bg-img-features text-center\" id=\"bonuses\">\n    <div class=\"overlay-layer overlay-slate-cool\"></div>\n    <div class=\"container\">\n      <div class=\"eyebrow-badge\">SECTION 44: FAST-ACTION BONUSES</div>\n      <h2 class=\"sec-title\">5 Fast-Action PDF Bonuses Included Free Today</h2>\n      <p class=\"sec-desc\">Total Bonus Value: <strong>$1,330</strong> — yours 100% FREE when you claim your KDP Profit Machine account during this launch.</p>\n\n      <!-- BONUS 1 (INDIVIDUAL 2-COLUMN SPLIT WITH 3D BOX MOCKUP) -->\n      <div class=\"card-panel text-left\" style=\"margin-top: 35px; margin-bottom: 30px; border: 2px solid var(--amber-border); background: #ffffff;\">\n        <div class=\"feature-split-grid\">\n          <div style=\"text-align: center;\">\n            <div style=\"background: linear-gradient(135deg, #fef08a 0%, #f59e0b 100%); border-radius: var(--radius-md); padding: 20px; box-shadow: var(--shadow-amber); border: 2px solid #ffffff; display: inline-block;\">\n              <img src=\"/wp-content/uploads/kdp-mafia/assets/bundle.png\" alt=\"Bonus #1 3D Box Mockup\" style=\"max-width: 220px; width: 100%; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.3);\">\n              <div class=\"mono-spec\" style=\"background: #0b0f19; color: #ffffff; font-weight: 800; padding: 4px 12px; border-radius: 4px; margin-top: 12px; font-size: 0.82rem;\">\n                3D QUICKSTART SUITE\n              </div>\n            </div>\n          </div>\n          <div>\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;\">\n              <span class=\"mono-spec\" style=\"background: var(--amber-bg); color: var(--amber-dark); font-weight: 900; padding: 4px 14px; border-radius: 50px; border: 1px solid var(--amber-border);\">BONUS #1</span>\n              <span class=\"mono-spec\" style=\"font-weight: 900; color: var(--crimson-fail); font-size: 1.1rem; text-decoration: line-through;\">VALUE: $47</span>\n            </div>\n            <h3 style=\"font-size: 1.6rem; color: var(--ink-deep); margin-bottom: 12px;\">\"First $100 on KDP\" Quickstart Guide</h3>\n            <p style=\"font-size: 1.1rem; color: var(--ink-body); line-height: 1.7; margin-bottom: 14px;\">\n              The exact step-by-step launch path to go from zero to your very first royalty paycheck on Amazon KDP in under 7 days.\n            </p>\n            <div style=\"font-weight: 700; color: var(--blue-cobalt);\" class=\"mono-spec\">\n              ✅ Step-by-Step Royalty Roadmap &nbsp;•&nbsp; ✅ First-Sale Checklist\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- BONUS 2 (INDIVIDUAL 2-COLUMN SPLIT WITH 3D BOX MOCKUP) -->\n      <div class=\"card-panel text-left\" style=\"margin-bottom: 30px; border: 2px solid #a5f3fc; background: #ffffff;\">\n        <div class=\"feature-split-grid\">\n          <div>\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;\">\n              <span class=\"mono-spec\" style=\"background: #ecfeff; color: var(--blue-cobalt); font-weight: 900; padding: 4px 14px; border-radius: 50px; border: 1px solid #a5f3fc;\">BONUS #2</span>\n              <span class=\"mono-spec\" style=\"font-weight: 900; color: var(--crimson-fail); font-size: 1.1rem; text-decoration: line-through;\">VALUE: $37</span>\n            </div>\n            <h3 style=\"font-size: 1.6rem; color: var(--ink-deep); margin-bottom: 12px;\">50 Proven Evergreen Niches Cheat-Sheet</h3>\n            <p style=\"font-size: 1.1rem; color: var(--ink-body); line-height: 1.7; margin-bottom: 14px;\">\n              Pre-researched, high-demand sub-niches with low competition scores ready for instant book generation today.\n            </p>\n            <div style=\"font-weight: 700; color: var(--amber-dark);\" class=\"mono-spec\">\n              ✅ Pre-Scored Niches &nbsp;•&nbsp; ✅ Year-Round Sales Categories\n            </div>\n          </div>\n          <div style=\"text-align: center;\">\n            <div style=\"background: linear-gradient(135deg, #cff4fc 0%, #0284c7 100%); border-radius: var(--radius-md); padding: 20px; box-shadow: var(--shadow-amber); border: 2px solid #ffffff; display: inline-block;\">\n              <img src=\"/wp-content/uploads/kdp-mafia/assets/feature_market.png\" alt=\"Bonus #2 3D Box Mockup\" style=\"max-width: 220px; width: 100%; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.3);\">\n              <div class=\"mono-spec\" style=\"background: #0b0f19; color: #ffffff; font-weight: 800; padding: 4px 12px; border-radius: 4px; margin-top: 12px; font-size: 0.82rem;\">\n                3D NICHE CHEAT-SHEET\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- BONUS 3 (INDIVIDUAL 2-COLUMN SPLIT WITH 3D BOX MOCKUP) -->\n      <div class=\"card-panel text-left\" style=\"margin-bottom: 30px; border: 2px solid #6ee7b7; background: #ffffff;\">\n        <div class=\"feature-split-grid\">\n          <div style=\"text-align: center;\">\n            <div style=\"background: linear-gradient(135deg, #d1fae5 0%, #059669 100%); border-radius: var(--radius-md); padding: 20px; box-shadow: 0 14px 36px rgba(5,150,105,0.25); border: 2px solid #ffffff; display: inline-block;\">\n              <img src=\"/wp-content/uploads/kdp-mafia/assets/feature_puzzle.png\" alt=\"Bonus #3 3D Box Mockup\" style=\"max-width: 220px; width: 100%; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); background: #ffffff;\">\n              <div class=\"mono-spec\" style=\"background: #0b0f19; color: #ffffff; font-weight: 800; padding: 4px 12px; border-radius: 4px; margin-top: 12px; font-size: 0.82rem;\">\n                3D PUBLISHING CALENDAR\n              </div>\n            </div>\n          </div>\n          <div>\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;\">\n              <span class=\"mono-spec\" style=\"background: var(--emerald-bg); color: var(--emerald-pass); font-weight: 900; padding: 4px 14px; border-radius: 50px; border: 1px solid #6ee7b7;\">BONUS #3</span>\n              <span class=\"mono-spec\" style=\"font-weight: 900; color: var(--crimson-fail); font-size: 1.1rem; text-decoration: line-through;\">VALUE: $27</span>\n            </div>\n            <h3 style=\"font-size: 1.6rem; color: var(--ink-deep); margin-bottom: 12px;\">Seasonal Publishing Calendar</h3>\n            <p style=\"font-size: 1.1rem; color: var(--ink-body); line-height: 1.7; margin-bottom: 14px;\">\n              Map out Q4 holiday sales surges, back-to-school rushes, and summer activity book launches with exact publishing dates.\n            </p>\n            <div style=\"font-weight: 700; color: var(--emerald-pass);\" class=\"mono-spec\">\n              ✅ Q1-Q4 Surge Map &nbsp;•&nbsp; ✅ Holiday Timing Blueprint\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- BONUS 4 (INDIVIDUAL 2-COLUMN SPLIT WITH 3D BOX MOCKUP) -->\n      <div class=\"card-panel text-left\" style=\"margin-bottom: 30px; border: 2px solid var(--amber-border); background: #ffffff;\">\n        <div class=\"feature-split-grid\">\n          <div>\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;\">\n              <span class=\"mono-spec\" style=\"background: var(--amber-bg); color: var(--amber-dark); font-weight: 900; padding: 4px 14px; border-radius: 50px; border: 1px solid var(--amber-border);\">BONUS #4</span>\n              <span class=\"mono-spec\" style=\"font-weight: 900; color: var(--crimson-fail); font-size: 1.1rem; text-decoration: line-through;\">VALUE: $37</span>\n            </div>\n            <h3 style=\"font-size: 1.6rem; color: var(--ink-deep); margin-bottom: 12px;\">KDP Keyword & Category Swipe File</h3>\n            <p style=\"font-size: 1.1rem; color: var(--ink-body); line-height: 1.7; margin-bottom: 14px;\">\n              Copy-paste 7 primary + 20 long-tail backend keywords and hidden category combinations to rank your books fast.\n            </p>\n            <div style=\"font-weight: 700; color: var(--blue-cobalt);\" class=\"mono-spec\">\n              ✅ Copy-Paste Keyword Combos &nbsp;•&nbsp; ✅ Secret Category Paths\n            </div>\n          </div>\n          <div style=\"text-align: center;\">\n            <div style=\"background: linear-gradient(135deg, #fef08a 0%, #d97706 100%); border-radius: var(--radius-md); padding: 20px; box-shadow: var(--shadow-amber); border: 2px solid #ffffff; display: inline-block;\">\n              <img src=\"/wp-content/uploads/kdp-mafia/assets/feature_launch.png\" alt=\"Bonus #4 3D Box Mockup\" style=\"max-width: 220px; width: 100%; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.3);\">\n              <div class=\"mono-spec\" style=\"background: #0b0f19; color: #ffffff; font-weight: 800; padding: 4px 12px; border-radius: 4px; margin-top: 12px; font-size: 0.82rem;\">\n                3D KEYWORD SWIPE FILE\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- BONUS 5 (INDIVIDUAL 2-COLUMN SPLIT WITH 3D BOX MOCKUP) -->\n      <div class=\"card-panel text-left\" style=\"margin-bottom: 30px; border: 2px solid #a5f3fc; background: #ffffff;\">\n        <div class=\"feature-split-grid\">\n          <div style=\"text-align: center;\">\n            <div style=\"background: linear-gradient(135deg, #cff4fc 0%, #0284c7 100%); border-radius: var(--radius-md); padding: 20px; box-shadow: var(--shadow-amber); border: 2px solid #ffffff; display: inline-block;\">\n              <img src=\"/wp-content/uploads/kdp-mafia/assets/bundle.png\" alt=\"Bonus #5 3D Box Mockup\" style=\"max-width: 220px; width: 100%; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.3);\">\n              <div class=\"mono-spec\" style=\"background: #0b0f19; color: #ffffff; font-weight: 800; padding: 4px 12px; border-radius: 4px; margin-top: 12px; font-size: 0.82rem;\">\n                3D PUBLISHERS COMMUNITY\n              </div>\n            </div>\n          </div>\n          <div>\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;\">\n              <span class=\"mono-spec\" style=\"background: #ecfeff; color: var(--blue-cobalt); font-weight: 900; padding: 4px 14px; border-radius: 50px; border: 1px solid #a5f3fc;\">BONUS #5</span>\n              <span class=\"mono-spec\" style=\"font-weight: 900; color: var(--crimson-fail); font-size: 1.1rem; text-decoration: line-through;\">VALUE: $97</span>\n            </div>\n            <h3 style=\"font-size: 1.6rem; color: var(--ink-deep); margin-bottom: 12px;\">Private \"Publishers\" Community Access</h3>\n            <p style=\"font-size: 1.1rem; color: var(--ink-body); line-height: 1.7; margin-bottom: 14px;\">\n              Connect with active top-earning KDP publishers, share strategies, and get direct technical support in our private publisher network.\n            </p>\n            <div style=\"font-weight: 700; color: var(--amber-dark);\" class=\"mono-spec\">\n              ✅ VIP Support &nbsp;•&nbsp; ✅ Publisher Networking & Case Studies\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </section>",
