              "settings": {
                "html": "<section class=\"sec-editorial bg-img-hero\" id=\"profit-angle-1\">\n    <div class=\"overlay-layer overlay-light-gold\"></div>\n    <div class=\"container\">\n      <div class=\"feature-split-grid\">\n        <div>\n          <div class=\"eyebrow-badge\">PROFIT ANGLE 01: ROYALTY CATALOG</div>\n          <h2 class=\"sec-title\">Build A Passive Amazon Royalty Empire</h2>\n          <p style=\"font-size: 1.25rem; color: var(--ink-body); margin-bottom: 22px; line-height: 1.8;\">\n            Publish a catalog of evergreen low-content & puzzle books that generate passive monthly royalties year after year — without spending a single dollar on inventory or shipping.\n          </p>\n          <div class=\"card-panel text-left\" style=\"background: #ffffff; border-left: 4px solid var(--amber-dark);\">\n            <div style=\"font-weight: 800; font-size: 1.1rem; color: var(--amber-dark);\" class=\"mono-spec\">⚡ ROYALTY ADVANTAGE:</div>\n            <p style=\"font-size: 1.05rem; margin-top: 6px;\">Work once to create the book file. Amazon prints and fulfills orders on demand, depositing royalties straight into your bank account.</p>\n          </div>\n        </div>\n        <div>\n          <img src=\"/wp-content/uploads/kdp-mafia/assets/bundle.png\" alt=\"Passive Royalty Catalog Engine\" class=\"feature-img-frame\" style=\"border-color: var(--amber-dark);\">\n        </div>\n      </div>\n    </div>\n  </section>",
