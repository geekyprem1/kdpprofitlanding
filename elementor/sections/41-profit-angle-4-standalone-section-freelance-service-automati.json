              "settings": {
                "html": "<section class=\"sec-editorial bg-img-hero\" id=\"profit-angle-4\">\n    <div class=\"overlay-layer overlay-emerald-pass\"></div>\n    <div class=\"container\">\n      <div class=\"feature-split-grid\">\n        <div>\n          <img src=\"/wp-content/uploads/kdp-mafia/assets/feature_cover.png\" alt=\"Freelance Service Automation\" class=\"feature-img-frame\" style=\"border-color: var(--emerald-pass);\">\n        </div>\n        <div>\n          <div class=\"eyebrow-badge\" style=\"background: var(--emerald-bg); color: var(--emerald-pass); border-color: #86efac;\">PROFIT ANGLE 04: FREELANCE GIGS</div>\n          <h2 class=\"sec-title\">Automate Fiverr & Upwork Book Layout Services</h2>\n          <p style=\"font-size: 1.25rem; color: var(--ink-body); margin-bottom: 22px; line-height: 1.8;\">\n            List book cover design, PDF interior formatting, or puzzle creation gigs on Fiverr and Upwork. Fulfill incoming orders in minutes using KDP Profit Machine's background engines.\n          </p>\n          <div class=\"card-panel text-left\" style=\"background: #ffffff; border-left: 4px solid var(--emerald-pass);\">\n            <div style=\"font-weight: 800; font-size: 1.1rem; color: var(--emerald-pass);\" class=\"mono-spec\">⚡ FREELANCE AUTOMATION:</div>\n            <p style=\"font-size: 1.05rem; margin-top: 6px;\">Zero manual formatting or design software needed. Simply input the client's specs and download print-ready PDF files instantly.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>",
