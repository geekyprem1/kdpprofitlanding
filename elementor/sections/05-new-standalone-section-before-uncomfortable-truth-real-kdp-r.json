                "html": "<section class=\"sec-editorial bg-grid-paper\" id=\"royalty-proof\">\n    <div class=\"overlay-layer overlay-warm-amber\"></div>\n    <div class=\"container\">\n      <div class=\"text-center\" style=\"max-width: 960px; margin: 0 auto 40px;\">\n        <div class=\"eyebrow-badge\" style=\"background: var(--amber-bg); color: var(--amber-dark); border-color: var(--amber-border);\">\n          REAL KDP ROYALTY PROOF & PROVEN RESULTS\n        </div>\n        <h2 class=\"sec-title\">See How KDP Authors & Publishers Are Generating <span class=\"highlight-orange-box\">$4,200 to $48,000/Month</span> In Passive Amazon Royalties</h2>\n        <p class=\"sec-desc\">Zero inventory, zero shipping labor — build a catalog of compliant low-content, puzzle, and activity books that pay you every single month.</p>\n      </div>\n\n      <!-- 3 ROYALTY PROOF CARDS GRID -->\n      <div class=\"grid-3\" style=\"margin-bottom: 45px;\">\n        <div class=\"card-panel\" style=\"border-top: 4px solid var(--emerald-pass); background: #ffffff;\">\n          <div class=\"mono-spec\" style=\"font-size: 0.85rem; color: var(--ink-muted); text-transform: uppercase;\">ROYALTY REPORT #1</div>\n          <div style=\"font-family: var(--font-mono); font-size: 2.2rem; font-weight: 900; color: var(--emerald-pass); margin: 8px 0;\">$48,290.50</div>\n          <div class=\"mono-spec\" style=\"background: var(--emerald-bg); color: var(--emerald-pass); padding: 4px 10px; border-radius: 4px; display: inline-block; font-weight: 800; font-size: 0.82rem; margin-bottom: 12px;\">\n            ▲ +310% PASSIVE GROWTH\n          </div>\n          <p style=\"font-size: 0.98rem; color: var(--ink-body);\">\"Built a catalog of 25 puzzle and activity books using KDP Profit Machine. Monthly royalty checks directly deposited by Amazon.\"</p>\n        </div>\n\n        <div class=\"card-panel\" style=\"border-top: 4px solid var(--amber-dark); background: #ffffff;\">\n          <div class=\"mono-spec\" style=\"font-size: 0.85rem; color: var(--ink-muted); text-transform: uppercase;\">ROYALTY REPORT #2</div>\n          <div style=\"font-family: var(--font-mono); font-size: 2.2rem; font-weight: 900; color: var(--amber-dark); margin: 8px 0;\">$24,800.12</div>\n          <div class=\"mono-spec\" style=\"background: var(--amber-bg); color: var(--amber-dark); padding: 4px 10px; border-radius: 4px; display: inline-block; font-weight: 800; font-size: 0.82rem; margin-bottom: 12px;\">\n            ▲ +240% EVERGREEN PUZZLE SALES\n          </div>\n          <p style=\"font-size: 0.98rem; color: var(--ink-body);\">\"Published 10 Large Print Word Search & Sudoku books. Every file passed Amazon's Print Previewer check on the 1st try.\"</p>\n        </div>\n\n        <div class=\"card-panel\" style=\"border-top: 4px solid var(--blue-cobalt); background: #ffffff;\">\n          <div class=\"mono-spec\" style=\"font-size: 0.85rem; color: var(--ink-muted); text-transform: uppercase;\">ROYALTY REPORT #3</div>\n          <div style=\"font-family: var(--font-mono); font-size: 2.2rem; font-weight: 900; color: var(--blue-cobalt); margin: 8px 0;\">$12,450.80</div>\n          <div class=\"mono-spec\" style=\"background: #ecfeff; color: var(--blue-cobalt); padding: 4px 10px; border-radius: 4px; display: inline-block; font-weight: 800; font-size: 0.82rem; margin-bottom: 12px;\">\n            ▲ +195% AGENCY CLIENT PROFITS\n          </div>\n          <p style=\"font-size: 0.98rem; color: var(--ink-body);\">\"Offered done-for-you KDP publishing services to local authors & business owners. Delivered complete book packages in hours.\"</p>\n        </div>\n      </div>\n\n      <!-- DEDICATED VISUAL & ROYALTY BENEFIT SUMMARY -->\n      <div class=\"feature-split-grid\" style=\"background: #ffffff; border: 2px solid var(--amber-border); border-radius: var(--radius-md); padding: 30px; box-shadow: var(--shadow-editorial);\">\n        <div>\n          <img src=\"/wp-content/uploads/kdp-mafia/assets/analytics_3d.png\" alt=\"3D Real KDP Royalty Proof Dashboard\" class=\"feature-img-frame\" style=\"border-color: var(--amber-dark);\">\n        </div>\n        <div>\n          <h3 style=\"font-size: 1.8rem; margin-bottom: 14px; color: var(--ink-deep);\">The Amazon Royalty Automation Engine</h3>\n          <p style=\"font-size: 1.1rem; line-height: 1.8; margin-bottom: 16px;\">\n            With KDP Profit Machine, you own a <strong>complete hands-free publishing system</strong> that transforms single keywords into real, complaint-free Amazon books.\n          </p>\n          <div style=\"display: flex; flex-direction: column; gap: 10px;\" class=\"mono-spec\">\n            <div style=\"color: var(--emerald-pass); font-weight: 800;\">🚀 ZERO INVENTORY &nbsp;|&nbsp; ⏱ BUILD ONCE &nbsp;|&nbsp; 💰 EARN PASSIVE ROYALTIES</div>\n            <div style=\"color: var(--blue-cobalt); font-weight: 800;\">🔒 Commercial License Included with $17 Purchase</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>",
